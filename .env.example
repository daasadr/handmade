# === DATABÁZE ===
POSTGRES_PASSWORD=nahradte_silnym_heslem

# === JWT ===
JWT_SECRET=nahradte_min_32_znaku_nahodnym_retezcem
JWT_EXPIRES_IN=7d

# === ANTHROPIC AI ===
ANTHROPIC_API_KEY=sk-ant-...

# === ETSY API (přehled konkurence) ===
# Volitelné. Bez klíče se skóre počítá jen z odhadu AI; s klíčem se u Etsy
# analýz přidá reálný přehled konkurence (počet nabídek, ceny, tagy) a skóre
# se počítá z reálných dat. Klíč: zaregistrujte aplikaci na
# https://www.etsy.com/developers → "Keystring".
# Formát pro OAuth: "keystring:shared_secret" (obojí z Etsy app). Jen na serveru,
# NIKDY do gitu/chatu — co projde chatem, přegeneruj.
ETSY_API_KEY=XXX

# === ETSY OAUTH PUSH (odeslání konceptu listingu) ===
# Šifrovací klíč pro refresh tokeny tvůrců v DB (AES-256-GCM). Min 32 znaků.
# Když chybí, Etsy OAuth je VYPNUTÉ (fail-safe) — zbytek appky jede dál.
# Vygeneruj např.: openssl rand -base64 48
ETSY_TOKEN_KEY=XXX
# Default Etsy taxonomy_id pro koncept (povinné pole Etsy). Výrobce kategorii
# v konceptu upraví. Ověř reálné ID při prvním živém testu (viz etsy-oauth-push).
ETSY_DEFAULT_TAXONOMY_ID=

# === HETZNER OBJECT STORAGE (S3-compatible) ===
# Endpoint najdete v Hetzner Console → Object Storage → bucket → nastavení
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=handmade-media
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
S3_REGION=eu-central

# === EMAIL (Resend.com) ===
# Získejte API klíč na https://resend.com → Settings → API Keys
# Doménu handmade.net musíte ověřit v Resend dashboard (DNS TXT záznam)
# Bez RESEND_API_KEY se emaily jen logují do konzole (vhodné pro lokální vývoj)
RESEND_API_KEY=re_...

# === APP ===
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
